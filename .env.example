# Gahmood Bot Environment Variables

# Telegram Bot Token - get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# LLM API - HighwayAPI (Grok 4.1 Fast Reasoning)
LLM_API_KEY=your_highwayapi_key_here
LLM_BASE_URL=https://api.highwayapi.ai/openai
MODEL_NAME=grok-4-1-fast-reasoning

# Tavily API - get from https://tavily.com
TAVILY_API_KEY=your_tavily_key_here

# Optional configs
MAX_HISTORY_MESSAGES=50
TENSION_THRESHOLD=0.4
COOLDOWN_MS=15000
MAX_RESPONSE_LENGTH=4096
